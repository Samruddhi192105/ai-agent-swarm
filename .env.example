# Copy this file to .env (same folder as docker-compose.yml) and fill in real values.
# .env is already in .gitignore, so it will never get committed or pushed.

GEMINI_API_KEY=

# Optional overrides — safe to leave as-is for local dev
DB_NAME=agentswarm
DB_USER=agentswarm
DB_PASSWORD=
LLM_GEMINI_MODEL=gemini-3.6-flash
